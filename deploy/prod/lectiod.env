# The core's settings at Latere, read by both roles; every LECTIO_* variable
# is in the core's configuration table (lectio specs/016-distribution.md).
# The database URLs are the terraform Secret lectio-db, the object store's
# key pair the terraform Secret lectiod-s3, and the 2 bearers the Secrets
# lectiod-authorizer and lectiod-keys, each named in a Deployment patch;
# none of them is here. What only one role reads is in that role's patch:
# the authorizer on the API, the key source on the workers.
#
# The origin serves the core under /v1/parsing, and the core serves its API
# under that base path in the place of its own /v1, so the Ingress forwards
# without a rewrite: a parse is /v1/parsing/parses/{parse} and the document
# /v1/parsing/openapi.yaml.
LECTIO_BASE_PATH=/v1/parsing
LECTIO_OIDC_ISSUERS=https://auth.latere.ai
# The bucket holds nothing but the core's objects, so there is no prefix.
# The region is the datacenter's, which the store expects in a signature,
# and a bucket is addressed as a host name under the endpoint.
LECTIO_BUCKET=latere-parsing
LECTIO_S3_ENDPOINT=https://fra1.digitaloceanspaces.com
LECTIO_S3_REGION=fra1
# A page is read with a Lux key of the context the parse belongs to, which
# a worker asks platformd for, so a tenant's pages spend that tenant's
# balance. Both roles read this: it also sets the scope a rate limit pauses
# to the tenant, a setting of the store that every process that opens it
# writes. The address and the bearer are the workers' alone, in their patch.
LECTIO_KEYS=endpoint
# A reader a platform administrator adds in the console (spec 202) reaches
# the gateway the file's readers reach, inside the cluster, and nothing
# else: the core refuses a stored reader that names another endpoint.
# Both roles read it, since both build the stored readers.
LECTIO_READER_ENDPOINTS=http://luxd-core.latere.svc.cluster.local:8080/v1/models/openai/v1
